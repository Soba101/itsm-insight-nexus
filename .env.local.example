# Local Docker Environment Configuration
# Copy this file to .env.local and use it when running with Docker

# Docker Postgres Connection (instead of Supabase)
# Note: These are NOT prefixed with VITE_ because they're for backend/scripts
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_DB=itsm_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# For connecting from the React app, you would need a connection string
# The app currently uses Supabase client, so you'd need to either:
# 1. Add a REST API layer to connect to Docker Postgres, OR
# 2. Use a tool like PostgREST to provide a REST API over Postgres

# If using PostgREST (optional, not included in docker-compose yet):
# API_BASE_URL=http://localhost:3000

# PgAdmin Access (optional web UI)
# http://localhost:5050
# Email: admin@localhost.com
# Password: admin
